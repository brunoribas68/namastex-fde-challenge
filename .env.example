# Opcional: liga o extrator LLM (sem isso, usa regex)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Ajustes da chamada de cotação (valores padrão)
QUOTE_TIMEOUT_S=3.0
QUOTE_MAX_ATTEMPTS=4
QUOTE_BACKOFF_S=0.4
QUOTE_DEADLINE_S=15.0

# Conversa parada há mais que isso (s) sai da memória
CONVERSATION_TTL_S=86400

# Cache do catálogo de planos (GET /planos); use 5 para a demo de mudança de catálogo (QA, seção K)
PLANS_CACHE_TTL_S=300

# Instabilidade simulada da quote-api (padrões do desafio). Descomente para QA:
# QUOTE_FAILURE_RATE=0.20
# QUOTE_SLOW_RATE=0.10
# QUOTE_SLOW_SECONDS=8
# QUOTE_SEED=42
